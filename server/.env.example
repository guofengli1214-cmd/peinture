# Backend local-dev environment — copy to `server/.env` (gitignored).
# Values line up with the `docker run ... mysql:8.0` command in the README,
# so local dev works out of the box.

PORT=3001
NODE_ENV=development

# --- Database (MySQL reachable from the host on 127.0.0.1:3306) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=peinture
DB_PASSWORD=peinture
DB_NAME=peinture

# --- Secret encryption (AES-256-GCM at rest) ---
# A dev fallback exists, but set a stable value so encrypted tokens survive
# restarts. Generate a real one with: openssl rand -hex 32
APP_ENCRYPTION_KEY=dev-local-encryption-key-change-me

# --- First-run admin (created automatically when the users table is empty) ---
# REQUIRED — if ADMIN_PASSWORD is empty, no admin is seeded and you can't log in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Sessions / cookie ---
SESSION_TTL_HOURS=168
# Must stay false over plain http://localhost or the browser drops the cookie.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
