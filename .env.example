# Peinture full-stack environment — copy to `.env` (gitignored) and fill in.

# --- Database ---
DB_NAME=peinture
DB_USER=peinture
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# --- Secrets ---
# Used to encrypt stored provider tokens / storage credentials at rest.
# Use a long, random, high-entropy value, e.g. `openssl rand -hex 32`.
APP_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# --- First-run admin (created automatically if the users table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Sessions / cookie ---
SESSION_TTL_HOURS=168
# Set to true ONLY when serving over HTTPS (otherwise the cookie is dropped).
COOKIE_SECURE=false

# --- Web ---
WEB_PORT=80
