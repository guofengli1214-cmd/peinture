# Frontend build/dev environment — copy to .env.local (gitignored).
# Runtime config (service mode, provider tokens, etc.) now comes from the
# server after login; there is no VITE_SERVICE_MODE anymore.

# Dev only: where `npm run dev` proxies /api to (the running backend).
# Defaults to http://localhost:3001 if unset.
VITE_API_PROXY=http://localhost:3001

# Optional: CORS image proxy used to fetch/download remote provider image URLs.
# Leave blank to use the built-in default.
VITE_PROXY_URL=
